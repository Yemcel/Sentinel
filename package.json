{
  "name": "sentinel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Security and uptime monitor for my web projects, on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply sentinel --remote",
    "db:migrate:local": "wrangler d1 migrations apply sentinel --local",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  }
}
